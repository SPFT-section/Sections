{
  "name": "section-app",
  "version": "1.0.0",
  "description": "SECTiON — เว็บแอปเขียนและอ่านนิยายแบบ Local-First ตกแต่งด้วยสไตล์ Glassmorphism",
  "main": "src/index.js",
  "homepage": "https://spft-section.github.io/Sections",
  "scripts": {
    "start": "serve -s dist -l ${PORT:-3000} --single",
    "dev:server": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "build:railway": "cross-env PUBLIC_PATH=/ webpack --mode production",
    "dev": "webpack serve --mode development",
    "deploy": "npm run build && gh-pages -d dist",
    "railway:start": "serve -s dist -l ${PORT:-3000} --single",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "novel",
    "writing",
    "reading",
    "local-first",
    "offline"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^10.1.0",
    "css-loader": "^6.8.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "gh-pages": "^6.1.1",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^3.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.88.0",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  },
  "dependencies": {
    "lucide-react": "^0.263.0",
    "lz-string": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.1",
    "serve": "^14.2.6",
    "uuid": "^9.0.0"
  }
}
